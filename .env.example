# --- App ---
DATABASE_URL=postgres://tally:tally@localhost:5432/tally
AUTH_SECRET=                    # generate: npx auth secret
APP_URL=http://localhost:3000

# Dev defaults to mock data (no Plaid credentials needed); production
# defaults to live Plaid. Set explicitly to override either direction.
# MOCK_DATA=true

# --- Plaid (Sandbox first — see README) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_ADDITIONAL_CONSENTED_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=http://localhost:3000/plaid/oauth
PLAID_WEBHOOK_URL=              # your ngrok/cloudflared tunnel + /api/plaid/webhook

# --- Secrets ---
# 32-byte key, base64: openssl rand -base64 32
MASTER_KEY=
CRON_SECRET=
CRON_TZ=America/New_York       # timezone for worker/index.ts's cron schedules (§8.1)

# --- Single admin user (used by `npm run seed:user`) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
