{
  "expo": {
    "name": "Tally",
    "slug": "tally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-pop.png",
    "scheme": "tally",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tejasraibagi.tally",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Tally uses Face ID to keep your financial data private when the app's lock is turned on."
      }
    },
    "android": {
      "package": "com.tejasraibagi.tally",
      "adaptiveIcon": {
        "backgroundColor": "#5B3BF5",
        "foregroundImage": "./assets/images/android-icon-pop-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#14121F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withUISceneLifecycle",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Classic",
            "ios": "./assets/images/icon.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#14513F"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0333b963-5ce3-4a86-9e64-bd2c561c7f70",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0333b963-5ce3-4a86-9e64-bd2c561c7f70"
      }
    }
  }
}
